# Copy this file to .env and edit only the values you need.
API_URL=https://api.tiki.vn/product-detail/api/v1/products
CSV_FILE=data/product_ids.csv
BATCH_SIZE=1000
REQUEST_DELAY=1
REQUEST_TIMEOUT=15
CHECKPOINT_EVERY=50

# Existing BytePlus handling; no additional retry/restart features yet.
SECURITY_RETRY_DELAY=120
MAX_SECURITY_RETRIES=2
MAX_NETWORK_RETRIES=2
RETRY_BASE_DELAY=2
